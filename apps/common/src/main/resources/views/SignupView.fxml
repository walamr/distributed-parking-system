<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="edu.kinneret.parking.common.ui.SignupController"
           onKeyPressed="#handleKeyPress">
    
    <VBox alignment="CENTER" spacing="20" styleClass="glass-pane"
          minWidth="340" maxWidth="340" maxHeight="-Infinity">
        
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <Label text="Create Your Account" styleClass="auth-title" wrapText="true" textAlignment="CENTER">
            <VBox.margin><Insets bottom="10"/></VBox.margin>
        </Label>

        <VBox spacing="15">
            <VBox spacing="5">
                <Label text="Full Name" styleClass="auth-label"/>
                <TextField fx:id="fullNameField" promptText="Enter your full name" styleClass="text-field" onKeyPressed="#handleKeyPress"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Email" styleClass="auth-label"/>
                <TextField fx:id="usernameField" promptText="Enter your email" styleClass="text-field" onKeyPressed="#handleKeyPress"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Password" styleClass="auth-label"/>
                <StackPane alignment="CENTER_RIGHT">
                    <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="password-field" onKeyPressed="#handleKeyPress"/>
                    <TextField fx:id="passwordTextField" promptText="Enter your password" styleClass="text-field" visible="false" onKeyPressed="#handleKeyPress"/>
                    <Button fx:id="togglePasswordBtn" onAction="#togglePasswordVisibility" styleClass="eye-button" text="👁">
                        <StackPane.margin><Insets right="10"/></StackPane.margin>
                    </Button>
                </StackPane>
            </VBox>
            
            <VBox spacing="5">
                <Label text="System Role" styleClass="auth-label"/>
                <ComboBox fx:id="roleCombo" maxWidth="Infinity" styleClass="combo-box" promptText="Choose your role..."/>
            </VBox>

            <VBox fx:id="vinContainer" spacing="5" visible="false" managed="false">
                <Label text="Vehicle VIN *" styleClass="auth-label"/>
                <TextField fx:id="vinField" promptText="XXX-XX-XXX" styleClass="text-field"/>
            </VBox>

            <VBox fx:id="enforcerContainer" spacing="5" visible="false" managed="false">
                <Label fx:id="enforcerIdLabel" text="Enforcer ID (9 digits) *" styleClass="auth-label"/>
                <TextField fx:id="enforcerIdField" promptText="Enter 9-digit ID" styleClass="text-field"/>
            </VBox>
        </VBox>

        <Button text="Signup" onAction="#handleSignup" 
                maxWidth="Infinity" styleClass="button-primary">
            <VBox.margin><Insets top="10"/></VBox.margin>
        </Button>

        <HBox alignment="CENTER" spacing="5">
            <Label text="Already have an account?" style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 14px;"/>
            <Hyperlink text="Log In" onAction="#handleLoginRedirect" styleClass="auth-link"/>
        </HBox>

        <Label fx:id="statusLabel" styleClass="status-label" style="-fx-text-fill: #fbbf24;" wrapText="true" alignment="CENTER" textAlignment="CENTER" maxWidth="Infinity"/>

        <HBox alignment="CENTER" spacing="5">
            <Label fx:id="statusDot" text="●" style="-fx-text-fill: #48bb78; -fx-font-size: 10px;"/>
            <Label fx:id="serverUrlLabel" text="Cloud Synchronized" style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 11px; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>
</StackPane>
