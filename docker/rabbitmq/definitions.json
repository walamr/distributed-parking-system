{
  "vhosts": [
    {
      "name": "/parking"
    }
  ],
  "users": [
    {
      "name": "customer",
      "password": "customer_pwd_rotated",
      "tags": ""
    },
    {
      "name": "peo_service",
      "password": "peo_pwd_rotated",
      "tags": ""
    },
    {
      "name": "mulligan_admin",
      "password": "admin_pwd_rotated",
      "tags": "administrator"
    },
    {
      "name": "queue_service",
      "password": "queue_pwd_rotated",
      "tags": ""
    },
    {
      "name": "storage_service",
      "password": "storage_pwd_rotated",
      "tags": ""
    }
  ],
  "permissions": [
    {
      "user": "customer",
      "vhost": "/parking",
      "configure": "^(amq\\.default|transactions\\.queue)$",
      "write": "^(amq\\.default|transactions\\.queue)$",
      "read": "^$"
    },
    {
      "user": "peo_service",
      "vhost": "/parking",
      "configure": "^(amq\\.default|transactions\\.queue|citations\\.queue)$",
      "write": "^(amq\\.default|transactions\\.queue|citations\\.queue)$",
      "read": "^$"
    },
    {
      "user": "mulligan_admin",
      "vhost": "/parking",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    },
    {
      "user": "queue_service",
      "vhost": "/parking",
      "configure": "^(amq\\.default|transactions\\.queue|citations\\.queue)$",
      "write": "^(amq\\.default|transactions\\.queue|citations\\.queue)$",
      "read": "^(amq\\.default|transactions\\.queue|citations\\.queue)$"
    },
    {
      "user": "storage_service",
      "vhost": "/parking",
      "configure": "^(amq\\.default|transactions\\.queue|citations\\.queue)$",
      "write": "^(amq\\.default|transactions\\.queue|citations\\.queue)$",
      "read": "^(amq\\.default|transactions\\.queue|citations\\.queue)$"
    }
  ],
  "queues": [
    {
      "name": "transactions.queue",
      "vhost": "/parking",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-quorum-initial-group-size": 3,
        "x-dead-letter-exchange": "parking.dlx",
        "x-dead-letter-routing-key": "transactions.dead"
      }
    },
    {
      "name": "citations.queue",
      "vhost": "/parking",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-quorum-initial-group-size": 3,
        "x-dead-letter-exchange": "parking.dlx",
        "x-dead-letter-routing-key": "citations.dead"
      }
    },
    {
      "name": "transactions.dlq",
      "vhost": "/parking",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "citations.dlq",
      "vhost": "/parking",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    }
  ],
  "policies": [],
  "parameters": [],
  "bindings": [
    {
      "source": "parking.dlx",
      "vhost": "/parking",
      "destination": "transactions.dlq",
      "destination_type": "queue",
      "routing_key": "transactions.dead",
      "arguments": {}
    },
    {
      "source": "parking.dlx",
      "vhost": "/parking",
      "destination": "citations.dlq",
      "destination_type": "queue",
      "routing_key": "citations.dead",
      "arguments": {}
    }
  ],
  "exchanges": [
    {
      "name": "parking.dlx",
      "vhost": "/parking",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ]
}
