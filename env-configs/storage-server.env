RABBITMQ_USERNAME=storage_service
RABBITMQ_PASSWORD=REPLACE_WITH_STORAGE_SERVICE_AMQP_PASSWORD
RABBITMQ_NODES=10.0.201.16:5671,10.0.201.17:5671,10.0.201.18:5671
RABBITMQ_VHOST=/parking
RABBITMQ_TLS_ENABLED=true
RABBITMQ_TRUSTSTORE_PATH=docker/rabbitmq/certs/truststore.jks
RABBITMQ_TRUSTSTORE_PASSWORD=password
RABBITMQ_KEYSTORE_PATH=docker/rabbitmq/certs/keystore.jks
RABBITMQ_KEYSTORE_PASSWORD=password
TLS_SERVER_KEYSTORE_PATH=docker/rabbitmq/certs/server-keystore.jks
TLS_SERVER_KEYSTORE_PASSWORD=password
RABBITMQ_TLS_ALLOW_INVALID_HOSTNAMES=true
RABBITMQ_CONNECTION_TIMEOUT_MS=5000
RABBITMQ_RECOVERY_INTERVAL_MS=5000
RABBITMQ_PUBLISH_CONFIRM_TIMEOUT_MS=10000
RABBITMQ_EXPECTED_NODES=3

MONGO_URI=mongodb://storage_db_user:REPLACE_WITH_MONGO_STORAGE_PASSWORD@10.0.201.23:27017,10.0.201.24:27017,10.0.201.25:27017/parking_db?replicaSet=rs0&authSource=admin&retryWrites=true&w=majority
MONGO_TLS_ENABLED=true
MONGO_TLS_CA_CERT_PATH=docker/mongodb/certs/ca-cert.pem
MONGO_TLS_ALLOW_INVALID_HOSTNAMES=true
MONGO_PASSWORD=REPLACE_WITH_MONGO_STORAGE_PASSWORD

HMAC_SECRET=REPLACE_WITH_SHARED_HMAC_SECRET_MIN_32_CHARS
NONCE_TTL_SECONDS=60

RECOMMENDER_NODES=10.0.201.22:8091,10.0.201.26:8092,10.0.201.29:8093

# Rotated MongoDB user passwords for dynamic script consumption
MONGO_ADMIN_PASSWORD=REPLACE_WITH_MONGO_ADMIN_PASSWORD
MONGO_STORAGE_PASSWORD=REPLACE_WITH_MONGO_STORAGE_PASSWORD
MONGO_PEO_PASSWORD=REPLACE_WITH_MONGO_PEO_PASSWORD
MONGO_CUSTOMER_PASSWORD=REPLACE_WITH_MONGO_CUSTOMER_PASSWORD

# Individual IPs for Docker Compose variable interpolation
RABBIT1_IP=10.0.201.16
RABBIT2_IP=10.0.201.17
RABBIT3_IP=10.0.201.18
MONGO1_IP=10.0.201.23
MONGO2_IP=10.0.201.24
MONGO3_IP=10.0.201.25
CUSTOMER_IP=
PEO_IP=
MO_IP=
RECOMMENDER1_IP=10.0.201.22
RECOMMENDER2_IP=10.0.201.26
RECOMMENDER3_IP=10.0.201.29
RECOMMENDER_NODES=10.0.201.22:8091,10.0.201.26:8092,10.0.201.29:8093
